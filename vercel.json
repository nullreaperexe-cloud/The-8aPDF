{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/announcements",
      "destination": "/Updates.html"
    },
    {
      "source": "/updates",
      "destination": "/Updates.html"
    },
    {
      "source": "/pdfs",
      "destination": "/Pdf.html"
    },
    {
      "source": "/tasks",
      "destination": "/Tasks.html"
    },
    {
      "source": "/settings",
      "destination": "/Settings.html"
    },
    {
      "source": "/chatbot",
      "destination": "/classic.html"
    },
    {
      "source": "/classic",
      "destination": "/classic.html"
    },
    {
      "source": "/:slug([a-zA-Z0-9-]{3,32})",
      "destination": "/api/redirect?slug=:slug"
    }
  ]
}
