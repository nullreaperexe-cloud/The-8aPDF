{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/html",
      "destination": "/index.html"
    },
    {
      "source": "/html/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/",
      "destination": "/about.html"
    },
    {
      "source": "/api/materials",
      "destination": "/api/materials"
    },
    {
      "source": "/api/announcements",
      "destination": "/api/announcements"
    },
    {
      "source": "/database",
      "destination": "/database.html"
    },
    {
      "source": "/live-database",
      "destination": "/database.html"
    },
    {
      "source": "/tests",
      "destination": "/index.html"
    },
    {
      "source": "/important-messages",
      "destination": "/index.html"
    },
    {
      "source": "/school-reminders",
      "destination": "/index.html"
    },
    {
      "source": "/notification-settings",
      "destination": "/index.html"
    },
    {
      "source": "/chat/index.html",
      "destination": "/chat-frame.html"
    },
    {
      "source": "/pdf-explorer",
      "destination": "/index.html"
    },
    {
      "source": "/school-calendar",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/chat/",
      "destination": "/index.html"
    },
    {
      "source": "/chat/:room",
      "destination": "/index.html"
    },
    {
      "source": "/chat/:room/",
      "destination": "/index.html"
    },
    {
      "source": "/announcements",
      "destination": "/index.html"
    },
    {
      "source": "/updates",
      "destination": "/index.html"
    },
    {
      "source": "/pdfs",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/chatbot",
      "destination": "/index.html"
    },
    {
      "source": "/tasks",
      "destination": "/index.html"
    },
    {
      "source": "/classic",
      "destination": "/classic.html"
    },
    {
      "source": "/Pdf.html",
      "destination": "/index.html"
    },
    {
      "source": "/Updates.html",
      "destination": "/index.html"
    },
    {
      "source": "/Tasks.html",
      "destination": "/index.html"
    },
    {
      "source": "/Settings.html",
      "destination": "/index.html"
    },
    {
      "source": "/:slug([a-zA-Z0-9-]{3,32})",
      "destination": "/api/redirect?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://xudhjwojgxblbsebkzso.supabase.co; img-src 'self' data:; frame-src https:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/school-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
