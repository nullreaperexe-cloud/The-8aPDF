{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/tests",
      "destination": "/index.html"
    },
    {
      "source": "/important-messages",
      "destination": "/index.html"
    },
    {
      "source": "/school-reminders",
      "destination": "/index.html"
    },
    {
      "source": "/notification-settings",
      "destination": "/index.html"
    },
    {
      "source": "/chat/index.html",
      "destination": "/chat-frame.html"
    },
    {
      "source": "/pdf-explorer",
      "destination": "/index.html"
    },
    {
      "source": "/school-calendar",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/chat/",
      "destination": "/index.html"
    },
    {
      "source": "/chat/:room",
      "destination": "/index.html"
    },
    {
      "source": "/chat/:room/",
      "destination": "/index.html"
    },
    {
      "source": "/announcements",
      "destination": "/index.html"
    },
    {
      "source": "/updates",
      "destination": "/index.html"
    },
    {
      "source": "/pdfs",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/chatbot",
      "destination": "/index.html"
    },
    {
      "source": "/tasks",
      "destination": "/index.html"
    },
    {
      "source": "/classic",
      "destination": "/classic.html"
    },
    {
      "source": "/Pdf.html",
      "destination": "/index.html"
    },
    {
      "source": "/Updates.html",
      "destination": "/index.html"
    },
    {
      "source": "/Tasks.html",
      "destination": "/index.html"
    },
    {
      "source": "/Settings.html",
      "destination": "/index.html"
    },
    {
      "source": "/:slug([a-zA-Z0-9-]{3,32})",
      "destination": "/api/redirect?slug=:slug"
    }
  ]
}
